# Keel environment template. Copy to `.env` and fill in.
#
#     cp .env.example .env
#
# `.env` is gitignored and never committed; this file is committed and must
# never contain a real credential. Configuration that shapes *routing* lives in
# config/keel.yaml (FR-2.3) — this file carries only secrets and deployment
# wiring, the two things that differ per machine.
#
# Variable names follow LiteLLM's conventions, because the adapter layer sits
# above LiteLLM (TECHNICAL-DESIGN.md §5.3, D4) and renaming them would buy a
# translation step and nothing else.

# --- Gateway -----------------------------------------------------------------

# Path to the routing config. Validated at startup; an invalid file fails the
# process rather than surfacing at the first request (NFR-4).
KEEL_CONFIG_PATH=config/keel.yaml

# Health windows, breaker state, deferred queue, idempotency (§5.5).
# Inside docker compose the host is the service name, not localhost.
REDIS_URL=redis://localhost:6379/0

# Structured JSON logs, correlated by request_id (FR-7.3). Both are read at
# startup; an unrecognised value fails the process rather than being guessed at,
# for the same reason an invalid routing config does (NFR-4).

# DEBUG | INFO | WARNING | ERROR | CRITICAL
KEEL_LOG_LEVEL=INFO

# json    - one JSON object per line. What the compose stack and any log
#           aggregator want, and the default.
# console - colourised and human-readable, for a local terminal.
KEEL_LOG_FORMAT=json

# --- Cohere (primary, FR-2.1) ------------------------------------------------

COHERE_API_KEY=

# --- Azure OpenAI (fallback, FR-2.6) -----------------------------------------
#
# Commented out until the quota request is approved. Uncomment in Phase 4, and
# remove `azure_fallback` from every preference list in config/keel.yaml until
# then — a preference entry whose credentials are absent is a failover target
# that does not exist.

# AZURE_API_KEY=
# AZURE_API_BASE=https://<resource-name>.openai.azure.com
# AZURE_API_VERSION=2024-10-21

# --- AWS Bedrock (fallback, FR-2.6) ------------------------------------------
#
# Commented out until model access is approved. Also needs the optional
# dependency group: `pip install -e ".[bedrock]"`.

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=eu-central-1
